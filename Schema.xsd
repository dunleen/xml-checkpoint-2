<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"> 

<xs:simpleType name="sixDigitsPattern">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{6}"/>
    </xs:restriction>
  </xs:simpleType>

	<xs:simpleType name="phonePattern">
		<xs:restriction base="xs:string">
			<xs:pattern value = "\d{3}-\d{2}-\d{2}"></xs:pattern>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="phoneType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="work"></xs:enumeration>
			<xs:enumeration value="home"></xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

<xs:element name="notebook">
	<xs:complexType>
		<xs:sequence>
			<xs:element name = "offices" minOccurs="1" maxOccurs="1"> 
				<xs:complexType>
					<xs:sequence>
						<xs:element name="office" minOccurs="1" maxOccurs="unbounded">
							<xs:complexType>
								<xs:simpleContent>
									<xs:extension base="xs:string">
										<xs:attribute name = "code" type="xs:string" use = "required"></xs:attribute>
									</xs:extension>
								</xs:simpleContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
				<xs:unique name="officeCodeUnique">
					<xs:selector xpath="office"></xs:selector>
					<xs:field xpath="@code"></xs:field>
				</xs:unique>
			</xs:element>
			<xs:element name = "person" minOccurs="1" maxOccurs="unbounded"> 
				<xs:complexType>
					<xs:sequence>
						<xs:element name="name" minOccurs="1" maxOccurs="1">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="first" type="xs:string"></xs:element>
									<xs:element name="surname" type="xs:string"></xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="address" minOccurs="1" maxOccurs="1">
							<xs:complexType>
								<xs:all>
									<xs:element name="city" type="xs:string"></xs:element>
									<xs:element name="street" type="xs:string"></xs:element>
									<xs:element name="index" type="sixDigitsPattern"></xs:element>
								</xs:all>
							</xs:complexType>
						</xs:element>
						<xs:element name="phones" minOccurs="1" maxOccurs="1">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="phone" minOccurs="0" maxOccurs="unbounded">
										<xs:complexType>
											<xs:simpleContent>
												<xs:extension base="phonePattern">
													<xs:attribute name="type" type = "phoneType" use = "optional"></xs:attribute>
												</xs:extension>
											</xs:simpleContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="id" type="xs:string" use = "required"></xs:attribute>
					<xs:attribute name = "office" type = "xs:string" use = "required"></xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	<xs:unique name="personIdUnique">
    <xs:selector xpath="person"/>
    <xs:field xpath="@id"/>
  </xs:unique>

	<xs:key name="officeCodeKey">
		<xs:selector xpath="offices/office"></xs:selector>
		<xs:field xpath="@code"></xs:field>
	</xs:key>

	<xs:keyref name="personOfficeRef" refer="officeCodeKey">
		<xs:selector xpath="person"></xs:selector>
		<xs:field xpath="@office"></xs:field>
	</xs:keyref>     

</xs:element>
</xs:schema>